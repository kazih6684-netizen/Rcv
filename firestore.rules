rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
    
    match /admin_sms_logs/{logId} {
      allow read, write: if true;
    }
    
    match /failed_parse_logs/{logId} {
      allow read, write: if true;
    }
    
    match /payments/{paymentId} {
      allow read, write: if true;
    }
    
    match /pending_payments/{requestId} {
      allow read, write: if true;
    }
    
    match /payment_match_logs/{matchId} {
      allow read, write: if true;
    }
  }
}
